#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"

pnpm verify

if command -v trivy >/dev/null 2>&1; then
  trivy fs --scanners secret --exit-code 1 --skip-dirs '**/node_modules,**/.git,**/.vitest,**/.stryker-tmp' --skip-files '**/.env,**/.env.local' .
else
  echo "trivy not installed; skipping secret scan (https://aquasecurity.github.io/trivy/latest/getting-started/installation/). CI still runs it." >&2
fi
