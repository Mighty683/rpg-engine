{
  "name": "rpg-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @rpg-engine/frontend --filter @rpg-engine/backend dev",
    "dev:compose": "podman compose up --build",
    "compose:down": "podman compose down",
    "build": "pnpm --filter @rpg-engine/frontend build",
    "preview": "pnpm --filter @rpg-engine/frontend preview",
    "seed:demo": "pnpm --filter @rpg-engine/backend seed:demo",
    "lint": "vp lint && pnpm check:boundaries",
    "check:boundaries": "depcruise --config .dependency-cruiser.mjs packages/*/src",
    "knip": "knip",
    "check": "pnpm check:boundaries && pnpm --filter @rpg-engine/frontend check:tokens && vp check packages scripts vite.config.ts package.json && pnpm --filter @rpg-engine/backend openapi:lint && pnpm --filter @rpg-engine/backend openapi:bundle",
    "test": "vp test --run packages/backend/src packages/frontend/src packages/frontend/prototypes lint --exclude '**/*.integration.test.ts' --exclude '**/migrations.test.ts'",
    "test:integration": "node scripts/test-integration.mjs",
    "verify": "pnpm check && pnpm --filter @rpg-engine/backend build && pnpm build && pnpm test && pnpm --filter @rpg-engine/frontend test:browser --run && pnpm test:integration",
    "scan:secrets": "trivy fs --scanners secret --exit-code 1 --skip-dirs '**/node_modules,**/.git,**/.vitest,**/.stryker-tmp' --skip-files '**/.env,**/.env.local' .",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "graph": "node scripts/dependency-graph.mjs frontend backend",
    "graph:frontend": "node scripts/dependency-graph.mjs frontend",
    "graph:backend": "node scripts/dependency-graph.mjs backend"
  },
  "devDependencies": {
    "@viz-js/viz": "^3.31.0",
    "dependency-cruiser": "^18.9.0",
    "knip": "^6.48.0",
    "vite-plus": "1.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.x",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
