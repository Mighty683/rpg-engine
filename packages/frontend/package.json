{
  "name": "@rpg-engine/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc -b && vp build",
    "preview": "vp preview",
    "check": "vp check",
    "test:browser": "vp test --config vitest.browser.config.ts",
    "prototypes:dev": "vp dev --config prototypes/vite.config.ts",
    "prototypes:build": "vue-tsc --noEmit -p prototypes/tsconfig.json && vp build --config prototypes/vite.config.ts"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.0",
    "tailwindcss": "4.3.4",
    "vee-validate": "^4.15.1",
    "vue": "3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "5.1.0",
    "@vue/tsconfig": "0.9.1",
    "playwright": "^1.64.1",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "vue-tsc": "3.3.13"
  }
}
