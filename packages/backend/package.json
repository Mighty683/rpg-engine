{
  "name": "@rpg-engine/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "vp lint --no-error-on-unmatched-pattern",
    "check": "vp check --no-error-on-unmatched-pattern",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "arrow-express": "4.0.0",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3"
  }
}
