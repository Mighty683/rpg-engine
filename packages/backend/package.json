{
  "name": "@rpg-engine/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "vp lint --no-error-on-unmatched-pattern",
    "check": "vp check --no-error-on-unmatched-pattern",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "seed:demo": "node --env-file-if-exists=.env src/seed-demo.ts",
    "build": "tsc --noEmit",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "arrow-express": "4.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.1.0",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3"
  }
}
