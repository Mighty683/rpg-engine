DATABASE_URL=postgresql://rpg_engine:local_dev_password@localhost:5432/rpg_engine
# Production migrations require a separate privileged connection.
# MIGRATION_DATABASE_URL=postgresql://migration_owner:password@localhost:5432/rpg_engine
# Set APP_ORIGIN when serving the app outside localhost.
# Local development only; use a unique secret of at least 32 bytes in production.
INVITATION_SECRET=local-development-secret-change-before-deployment

# Use a unique, random secret of at least 32 bytes in production.
CSRF_SECRET=local-development-csrf-secret-change-before-production
# Production requires trusted proxy IP addresses/subnets, or `none` for direct access.
# TRUSTED_PROXIES=127.0.0.1/32
